# Copy to .env (gitignored) and adjust. Real environment variables override this file.

# PostgreSQL with PostGIS. Add user:password@ if your server needs them; never commit real credentials.
# Supabase's db.<ref>.supabase.co host is IPv6-only. From an IPv4 network use the session pooler
# (Dashboard → Connect), with sslmode=require. The user is postgres.<project-ref>, port 5432.
# DATABASE_URL=postgresql://postgres.<ref>:[password]@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://localhost:5432/gigahack

# Signs login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me

# Optional
# JWT_TTL_HOURS=24
# UPLOAD_DIR=/absolute/path/to/uploads
# TEST_DATABASE_URL=postgresql://localhost:5432/gigahack_test
